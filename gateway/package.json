{
  "name": "civora-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Node gateway: security headers, rate limiting, API proxy to Flask and static hosting of the React build",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^4.2.1",
    "morgan": "^1.12.1"
  }
}
